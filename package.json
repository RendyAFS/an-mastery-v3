{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "local": "vite build && vite",
        "get-update": "git pull origin develop && composer install && npm install && php artisan migrate && php artisan db:seed --class=MenuPermissionSeeder && vite build && vite",
        "update": "composer install && npm install && php artisan migrate && php artisan db:seed --class=MenuPermissionSeeder && vite build && vite",
        "seeder": "composer install && npm install && php artisan migrate:fresh && php artisan db:seed && vite build && vite"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "esbuild": "^0.28.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.7.6",
        "@pqina/pintura": "^8.95.7",
        "@preline/datatable": "^3.2.3",
        "alpinejs": "^3.15.3",
        "datatables.net-dt": "^2.3.6",
        "filepond": "^4.32.11",
        "filepond-plugin-file-validate-type": "^1.2.9",
        "filepond-plugin-image-crop": "^2.0.6",
        "filepond-plugin-image-edit": "^1.6.3",
        "filepond-plugin-image-preview": "^4.6.12",
